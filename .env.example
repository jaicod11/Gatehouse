# Copy to .env and fill in, then restart with `npx expo start -c`.
# EXPO_PUBLIC_* values are bundled into the app and visible to users. Don't put secrets here.

# Supabase project settings (Dashboard > Project Settings > API Keys). Required.
# Use the publishable key (sb_publishable_...) or the legacy anon key. NEVER the secret /
# service_role key: anything here ships to every user.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only Google accounts on this domain may sign in. Defaults to hbplus.fit when unset.
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit
